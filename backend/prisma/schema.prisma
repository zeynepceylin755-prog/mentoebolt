generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  firstName       String
  lastName        String
  role            String    @default("STUDENT")
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  verificationToken String?
  verificationTokenExpiry DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?
  lastLoginAt     DateTime?
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  studentProfile  StudentProfile?
  refreshTokens   RefreshToken[]
  sessions        Session[]
  auditLogs       AuditLog[]
  idempotencyRecords IdempotencyRecord[]

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  grade           Int       @default(11)
  school          String?
  learningStage   String    @default("DISCOVERY")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningSessions LearningSession[]
  questionAttempts QuestionAttempt[]
  skillMasteries  SkillMastery[]
  topicMasteries  TopicMastery[]
  learningProgress LearningProgress[]
  errorAnalyses   ErrorAnalysis[]
  recommendations Recommendation[]
  assessmentAttempts AssessmentAttempt[]
  assessmentResults AssessmentResult[]
  diagnosticResults DiagnosticResult[]
  masteryAudits   MasteryAudit[]

  @@index([userId])
  @@index([grade])
  @@index([learningStage])
}

model LearningSession {
  id              String    @id @default(cuid())
  studentId       String
  sessionType     String    @default("PRACTICE")
  status          String    @default("ACTIVE")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  totalQuestions  Int       @default(0)
  correctAnswers  Int       @default(0)
  durationSeconds Int?
  expiresAt       DateTime?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questions       LearningSessionQuestion[]
  attempts        QuestionAttempt[]

  @@index([studentId])
  @@index([status])
  @@index([sessionType])
  @@index([startedAt])
  @@index([expiresAt])
}

model LearningSessionQuestion {
  id              String    @id @default(cuid())
  sessionId       String
  questionId      String
  order           Int
  status          String    @default("PENDING")
  answeredAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session         LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id])
  attempt         QuestionAttempt?

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([status])
}

model Question {
  id              String    @id @default(cuid())
  content         String
  type            String    @default("MULTIPLE_CHOICE")
  difficulty      Int       @default(1)
  skillId         String
  learningObjectiveId String?
  correctAnswer   String
  explanation     String?
  isActive        Boolean   @default(true)
  exposureCount   Int       @default(0)
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  options         QuestionOption[]
  attempts        QuestionAttempt[]
  sessionQuestions LearningSessionQuestion[]
  assessmentQuestions AssessmentQuestion[]

  @@index([skillId])
  @@index([learningObjectiveId])
  @@index([difficulty])
  @@index([isActive])
}

model QuestionOption {
  id          String    @id @default(cuid())
  questionId  String
  text        String
  isCorrect   Boolean   @default(false)
  order       Int
  createdAt   DateTime  @default(now())

  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@index([questionId])
}

model QuestionAttempt {
  id              String    @id @default(cuid())
  studentId       String
  questionId      String
  sessionId       String?
  sessionQuestionId String? @unique
  assessmentAttemptId String?
  answer          String
  isCorrect       Boolean
  timeSpentSeconds Int
  confidence      Float?
  errorType       String?
  status          String    @default("COMPLETED")
  validatedAt     DateTime  @default(now())
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id])
  session         LearningSession? @relation(fields: [sessionId], references: [id])
  sessionQuestion LearningSessionQuestion? @relation(fields: [sessionQuestionId], references: [id])
  assessmentAttempt AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id])
  errorAnalysis   ErrorAnalysis?
  masteryAudits   MasteryAudit[]

  @@unique([id, sessionId])
  @@index([studentId])
  @@index([questionId])
  @@index([sessionId])
  @@index([assessmentAttemptId])
  @@index([isCorrect])
  @@index([createdAt])
  @@index([status])
  @@index([errorType])
}

model ErrorAnalysis {
  id              String    @id @default(cuid())
  attemptId       String    @unique
  studentId       String
  errorType       String
  confidence      Float
  hypothesis      String
  relatedSkills   String?
  validated       Boolean   @default(false)
  validationQuestionId String?
  validationResult Boolean?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attempt         QuestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([attemptId])
  @@index([errorType])
  @@index([validated])
  @@index([createdAt])
}

model SkillMastery {
  id              String    @id @default(cuid())
  studentId       String
  skillId         String
  masteryLevel    Float     @default(0)
  confidence      Float     @default(0)
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  lastAttemptAt   DateTime?
  trend           String?
  nextReviewAt    DateTime?
  evidenceCount   Int       @default(0)
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@index([studentId])
  @@index([skillId])
  @@index([masteryLevel])
  @@index([confidence])
  @@index([nextReviewAt])
}

model TopicMastery {
  id              String    @id @default(cuid())
  studentId       String
  topicId         String
  masteryLevel    Float     @default(0)
  confidence      Float     @default(0)
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  lastAttemptAt   DateTime?
  evidenceCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([studentId])
  @@index([topicId])
  @@index([masteryLevel])
}

model LearningProgress {
  id              String    @id @default(cuid())
  studentId       String
  skillId         String
  date            DateTime  @default(now())
  masteryLevel    Float
  attemptsCount   Int
  correctCount    Int
  createdAt       DateTime  @default(now())

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([skillId])
  @@index([date])
  @@unique([studentId, skillId, date])
}

model Recommendation {
  id              String    @id @default(cuid())
  studentId       String
  focusSkillId    String
  focusSkillName  String
  reason          String
  estimatedTimeMinutes Int
  priority        Int       @default(3)
  actionType      String    @default("PRACTICE")
  status          String    @default("PENDING")
  acceptedAt      DateTime?
  completedAt     DateTime?
  dismissedAt     DateTime?
  expiresAt       DateTime?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Assessment {
  id              String    @id @default(cuid())
  title           String
  description     String?
  type            String    @default("DIAGNOSTIC")
  status          String    @default("DRAFT")
  skillIds        String?
  topicIds        String?
  totalQuestions  Int       @default(0)
  timeLimitMinutes Int?
  passingScore    Float?
  isActive        Boolean   @default(true)
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@index([type])
  @@index([status])
  @@index([isActive])
}

model AssessmentQuestion {
  id              String    @id @default(cuid())
  assessmentId    String
  questionId      String
  order           Int
  points          Int       @default(1)
  difficulty      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
  @@index([order])
}

model AssessmentAttempt {
  id              String    @id @default(cuid())
  studentId       String
  assessmentId    String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String    @default("IN_PROGRESS")
  score           Float?
  maxScore        Float?
  percentageScore Float?
  timeSpentSeconds Int?
  answers         String?
  results         String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  questionAttempts QuestionAttempt[]
  diagnosticResult DiagnosticResult?
  assessmentResults AssessmentResult[]

  @@unique([studentId, assessmentId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
}

model AssessmentResult {
  id              String    @id @default(cuid())
  assessmentAttemptId String
  studentId       String
  skillId         String
  topicId         String?
  score           Float
  maxScore        Float
  percentageScore Float
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  confidence      Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attempt         AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assessmentAttemptId])
  @@index([studentId])
  @@index([skillId])
  @@index([topicId])
}

model DiagnosticResult {
  id              String    @id @default(cuid())
  assessmentAttemptId String @unique
  studentId       String
  overallScore    Float
  overallConfidence Float
  summary         String?
  skillResults    String?
  topicResults    String?
  recommendations String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attempt         AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assessmentAttemptId])
  @@index([studentId])
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByTokenId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique
  expiresAt       DateTime
  lastActivityAt  DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id              String    @id @default(cuid())
  userId          String?
  action          String
  entityType      String
  entityId        String?
  details         String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  user            User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// NEW MODELS FOR PHASE 1A.1
// ============================================

model IdempotencyRecord {
  id          String    @id @default(cuid())
  key         String
  userId      String
  operation   String
  requestHash String
  status      String    @default("PROCESSING")
  response    String?
  statusCode  Int?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([key])
  @@index([status, expiresAt])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lastError     String?
  availableAt   DateTime  @default(now())
  processingAt  DateTime?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  metadata      String?

  @@index([status, availableAt])
  @@index([aggregateId])
  @@index([createdAt])
  @@index([processingAt])
}

model MasteryAudit {
  id              String    @id @default(cuid())
  studentId       String
  skillId         String
  attemptId       String?
  previousMastery Float
  newMastery      Float
  reason          String
  source          String
  correlationId  String?
  createdAt       DateTime  @default(now())

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attempt         QuestionAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([studentId, skillId])
  @@index([createdAt])
  @@index([source])
  @@index([correlationId])
}
