# ============================================
# MENTORA Backend Environment
# ============================================

# APPLICATION
NODE_ENV=production
PORT=3000
APP_NAME=mentora-backend

# DATABASE (Production: PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/mentora

# JWT AUTHENTICATION (Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_32_CHAR_MINIMUM
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_32_CHAR_MINIMUM
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=https://mentora.ai,https://app.mentora.ai

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI PROVIDERS
AI_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4-turbo-preview

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json

# FEATURES
ENABLE_AI=true
ENABLE_ANALYTICS=true
ENABLE_EMAIL=true
ENABLE_CACHE=true
ENABLE_QUEUE=true
