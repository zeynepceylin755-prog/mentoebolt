# ============================================
# MENTORA Backend Environment
# ============================================
#
# PHASE 7.3 — PRODUCTION REQUIREMENTS (enforced at startup, fail-closed)
#
# When NODE_ENV=production the backend REFUSES TO START unless all of the
# following are genuinely provisioned. Placeholders below are NOT acceptable:
#   - JWT_SECRET / JWT_REFRESH_SECRET: 32+ chars, distinct, not a known default
#     (generate with: openssl rand -base64 32)
#   - DATABASE_URL: a real production database (not a file: SQLite URL)
#   - CORS_ORIGINS: explicit https origins, no "*", no localhost
#   - A real AI provider (e.g. OCR_PROVIDER=openai) additionally requires
#     OPENAI_API_KEY and the matching *_ALLOW_EXTERNAL_PROVIDER=true
# Development/test keep convenient defaults; only production fails closed.
#
# APPLICATION
NODE_ENV=production
PORT=3000
APP_NAME=mentora-backend

# DATABASE
# SQLite remains the default for local development/test workflows.
# For production deployments, use a PostgreSQL URL such as:
# DATABASE_URL=postgresql://mentora_app:replace_with_secure_password@postgres:5432/mentora
# Do not use a file: SQLite URL in production.
DATABASE_URL=postgresql://user:password@host:5432/mentora

# JWT AUTHENTICATION (Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_32_CHAR_MINIMUM
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_32_CHAR_MINIMUM
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=https://mentora.ai,https://app.mentora.ai

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI PROVIDERS
# Generic provider surface. Supported: mock | openai ( other family has an
# implementation). Safe default is mock; choosing a real provider requires a key.
AI_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json
# PHASE 5F.8 (C) — UPLOAD STORAGE (local development provider)
# Directory for uploaded binaries; never stored in the database.
UPLOAD_DIR=uploads
# Max accepted file size in bytes (kept below the 10mb JSON body limit).
MAX_UPLOAD_BYTES=7340032
# PHASE 5F.9-A — OCR PROVIDER SELECTION
# Safe default: mock. No student asset leaves the server.
# Allowed values: mock | openai
OCR_PROVIDER=mock
# Vision model used by the real provider (multimodal).
OCR_MODEL=gpt-4o
# Bounded per-request timeout (ms) and retry count (transient failures only).
OCR_TIMEOUT_MS=30000
OCR_MAX_RETRIES=2
# Phase 7.1 cost control: bounded output tokens and maximum accepted image size
# (bytes) before any external vision request is made.
OCR_MAX_TOKENS=1024
OCR_MAX_IMAGE_BYTES=7340032
# Explicit data-egress gate: MUST be true before the real provider may be used,
# because student images would be sent to an external service.
OCR_ALLOW_EXTERNAL_PROVIDER=false
# PHASE 5F.9-B — QUESTION UNDERSTANDING PROVIDER SELECTION
# Safe default: mock. No question text leaves the server.
# Allowed values: mock | openai
QUESTION_UNDERSTANDING_PROVIDER=mock
# Model used by the real provider for structured understanding.
QUESTION_UNDERSTANDING_MODEL=gpt-4o
# Bounded per-request timeout (ms) and retry count (transient failures only).
QUESTION_UNDERSTANDING_TIMEOUT_MS=30000
QUESTION_UNDERSTANDING_MAX_RETRIES=2
# Phase 7.1 cost control: bounded output tokens and bounded normalized-text input.
QUESTION_UNDERSTANDING_MAX_TOKENS=1024
QUESTION_UNDERSTANDING_MAX_INPUT_CHARS=8000
# Explicit data-egress gate for the real provider.
QUESTION_UNDERSTANDING_ALLOW_EXTERNAL_PROVIDER=false
# PHASE 5F.9-C — ERROR ANALYSIS PROVIDER SELECTION
# Safe default: mock. No question text or student answer leaves the server.
# Allowed values: mock | openai
ERROR_ANALYSIS_PROVIDER=mock
# Text model used by the real provider for structured classification.
ERROR_ANALYSIS_MODEL=gpt-4o
# Bounded per-request timeout (ms) and retry count (transient failures only).
ERROR_ANALYSIS_TIMEOUT_MS=30000
ERROR_ANALYSIS_MAX_RETRIES=2
# Phase 7.1 cost control: bounded output tokens.
ERROR_ANALYSIS_MAX_TOKENS=1024
# Explicit data-egress gate: MUST be true before the real provider may be used,
# because the student's answer would be sent to an external service.
ERROR_ANALYSIS_ALLOW_EXTERNAL_PROVIDER=false
# PHASE 5F.9-D — EXPLANATION / HINT PROVIDER SELECTION
# Safe default: mock. No question text or student answer leaves the server.
# Allowed values: mock | openai
EXPLANATION_PROVIDER=mock
# Text model used by the real provider for structured guidance.
EXPLANATION_MODEL=gpt-4o
# Bounded per-request timeout (ms) and retry count (transient failures only).
EXPLANATION_TIMEOUT_MS=30000
EXPLANATION_MAX_RETRIES=2
# Phase 7.1 cost control: bounded output tokens.
EXPLANATION_MAX_TOKENS=1024
# Explicit data-egress gate: MUST be true before the real provider may be used,
# because the student's answer would be sent to an external service. NOTE: the
# canonical answer is never sent, in any mode.
EXPLANATION_ALLOW_EXTERNAL_PROVIDER=false
# PHASE 7.1 — OPT-IN REAL AI SMOKE TESTS
# Default false: the normal test suite NEVER makes an external AI request.
RUN_REAL_AI_SMOKE_TESTS=false

# FEATURES
ENABLE_AI=true
ENABLE_ANALYTICS=true
ENABLE_EMAIL=true
ENABLE_CACHE=true
ENABLE_QUEUE=true
