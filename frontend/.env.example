# Backend API base URL. Must be set through the environment — the app never
# hardcodes localhost/127.0.0.1 or a production host.
#
# Example (local development):
# VITE_API_BASE_URL=http://localhost:3000/api/v1
#
# When unset, the app uses the same-origin `/api/v1` path (reverse-proxy setup).
VITE_API_BASE_URL=
